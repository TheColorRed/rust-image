    "workgroups"
  ],
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/*.code-search": true,
    "target": true,
    "**/*.js": true,
    ".venv*": true
  },
  "search.useIgnoreFiles": false,
  "svg.preview.background": "editor",
  "editor.semanticTokenColorCustomizations": {
    "enabled": true,
    "rules": {
      "*.mutable": {
        "italic": true,
        "bold": true,
        "underline": false
      }
    }
  },
  "git.ignoreLimitWarning": true,
  "rust-analyzer.lens.references.method.enable": true,
  "rust-analyzer.lens.references.trait.enable": true,
  "rust-analyzer.lens.references.adt.enable": true,
  "rust-analyzer.lens.references.enumVariant.enable": true,
  "editor.codeActionsOnSave": {
    "source.removeUnusedImports": "always",
    "source.organizeImports": "always",
    "source.organizeLinkDefinitions": "always",
    "source.sortImports": "always"
  },
  // "rust-analyzer.checkOnSave": false,
  "rust-analyzer.diagnostics.experimental.enable": true,
  "rust-analyzer.procMacro.enable": false,
  "react-native-tools.projectRoot": "C:/Users/untun/Documents/vscode/rust/image/apps/alakazam/mobile",
  "react-native-tools.logLevel": "Trace",
  "terminal.integrated.defaultProfile.windows": "Fish",
  // rav1d (AVIF decoding) assembles its x86 code with NASM at build time: `tools/nasm/nasm.exe` (portable NASM 3.02).
  "terminal.integrated.env.windows": {
    "NASM": "${workspaceFolder}/tools/nasm/nasm.exe"
  },
  "rust-analyzer.cargo.extraEnv": {
    "NASM": "${workspaceFolder}/tools/nasm/nasm.exe"
  }
}
