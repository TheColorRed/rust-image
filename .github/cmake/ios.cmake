set(CMAKE_SYSTEM_NAME iOS)
set(CMAKE_OSX_DEPLOYMENT_TARGET "$ENV{IPHONEOS_DEPLOYMENT_TARGET}" CACHE STRING "" FORCE)

if("$ENV{TARGET}" STREQUAL "x86_64-apple-ios")
  set(CMAKE_OSX_ARCHITECTURES x86_64 CACHE STRING "" FORCE)
  set(CMAKE_OSX_SYSROOT iphonesimulator CACHE STRING "" FORCE)
elseif("$ENV{TARGET}" STREQUAL "aarch64-apple-ios-sim")
  set(CMAKE_OSX_ARCHITECTURES arm64 CACHE STRING "" FORCE)
  set(CMAKE_OSX_SYSROOT iphonesimulator CACHE STRING "" FORCE)
else()
  set(CMAKE_OSX_ARCHITECTURES arm64 CACHE STRING "" FORCE)
  set(CMAKE_OSX_SYSROOT iphoneos CACHE STRING "" FORCE)
endif()

set(CMAKE_SYSTEM_PROCESSOR "${CMAKE_OSX_ARCHITECTURES}")